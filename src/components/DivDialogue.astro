---
import { Image } from "astro:assets";

import dialogueImg from "../assets/images/dialogue.png";

const { rightSide } = Astro.props;
---

<div
  class:list={[
    "inline-flex items-stretch gap-0 sm:bg-none",
    rightSide ? "bg-[linear-gradient(135deg,var(--color-figure)_96%,transparent_50%)]"
    : "bg-[linear-gradient(225deg,var(--color-figure)_96%,transparent_50%)]",
  ]}
>
  <Image
    src={dialogueImg}
    alt="Avatar de Puxka"
    width="95"
    height="120"
    class:list={[
      "object-contain",
      rightSide && "-translate-x-px order-1 scale-x-[-1]",
    ]}
  />
  <p
    class:list={[
      "bg-figure px-4 content-center text-white overflow-auto",
      !rightSide && "-translate-x-px",
    ]}
  >
    <slot />
  </p>
</div>

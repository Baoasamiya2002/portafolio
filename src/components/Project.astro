---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import DivDialogue from "../components/DivDialogue.astro";
import { Link, Badge, Heading } from "accessible-astro-components";
import { Image } from "astro:assets";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { project } = Astro.props;
---

<div class="flex justify-center pt-15 py-8">
  <div class="sm:w-2/4 w-11/12">
    <div>
      <Heading level="h1">{project.data.name}</Heading>
      <div class="flex flex-col gap-6">
        <div class="inline-flex gap-1.5">
          <Badge>
            <Icon name="time" />
            {project.data.time}
          </Badge>
          {
            project.data.link && (
              <Badge>
                <Link href={project.data.link} isExternal>
                  {project.data.name.includes("Latencia")
                    ? t("project.videogame.linkLabel")
                    : t("project.prototype.linkLabel")}
                </Link>
              </Badge>
            )
          }
        </div>
        {
          project.data.dialogues.map((dialogue: unknown, index: number) => (
            <>
              <DivDialogue
                rightSide={
                  !project.data.images.some(
                    (image: { indexDialogue: any }) =>
                      index % 2 === 0 || image.indexDialogue === `${index - 1}`,
                  )
                }
              >
                {dialogue}
              </DivDialogue>
              <div class="md:inline-flex items-end text-white bg-[linear-gradient(to_bottom,transparent_22%,#7030a0_22%)]">
                {project.data.images
                  .filter(
                    (image: { indexDialogue: any }) =>
                      image.indexDialogue === `${index}`,
                  )
                  .map((image: { url: any; caption: any }) => (
                    <figure>
                      <Image src={image.url} alt="" class="h-auto w-full" />
                      <figcaption class="p-1 pl-2">{image.caption}</figcaption>
                    </figure>
                  ))}
              </div>
            </>
          ))
        }
      </div>
    </div>
  </div>
</div>

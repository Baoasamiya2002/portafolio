---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import { Heading } from "accessible-astro-components";
import EmblaCarousel from "./EmblaCarousel.jsx";

const { projects } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface FilterButton {
  name: string;
  tag: string;
}
const filterButtons: FilterButton[] = [
  { name: t("nav.noFilter"), tag: "" },
  { name: t("nav.prototype"), tag: translatePath("web-proto") },
  { name: t("nav.evaluation"), tag: translatePath("eva-and-redes-works") },
  { name: t("nav.videogame"), tag: translatePath("videogame") },
];
---

<project-section>
  <div class="grid pt-15 pb-10 sm:pl-14 pl-3 gap-y-6">
    <div class="grid w-full gap-y-3">
      <Heading level="h1">{t("nav.proyects")}</Heading>
      <p class="text-lg">{t("nav.typeProject")}:</p>
      <EmblaCarousel
        slides={projects}
        filters={filterButtons}
        seeMoreLabel={t("nav.seeMore")}
        client:only="react"
      />
    </div>
  </div>
</project-section>

<script>
  class ProjectSection extends HTMLElement {
    connectedCallback() {
      const filterBtns = this.querySelectorAll("button");
      const projectCards = this.querySelectorAll("article");

      Array.from(filterBtns).forEach((btn) => {
        btn.addEventListener("click", () => {
          Array.from(filterBtns).forEach((b) => {
            b.classList.remove("bg-figure!", "text-white!");
            b.classList.add("bg-transparent!");
          });

          btn.classList.remove("bg-transparent!");
          btn.classList.add("bg-figure!", "text-white!");

          const tag = btn.getAttribute("tag") ?? "";

          Array.from(projectCards).forEach((card) => {
            if (card.id.startsWith(tag)) {
              card.classList.remove("hidden!");
            } else {
              card.classList.add("hidden!");
            }
          });
        });
      });
    }
  }

  customElements.define("project-section", ProjectSection);
</script>

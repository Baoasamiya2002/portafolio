---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import {
  Card,
  Heading,
  Button,
  Badge,
} from "accessible-astro-components";
import { getCollection } from "astro:content";

const { projects } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface FilterButton {
  name: string;
  tag: string;
}
const filterButtons: FilterButton[] = [
  { name: t("nav.noFilter"), tag: "" },
  { name: t("nav.prototype"), tag: translatePath("web-proto") },
  { name: t("nav.evaluation"), tag: translatePath("eva-and-redes-works") },
  { name: t("nav.videogame"), tag: translatePath("videogame") },
];
---

<project-section>
  <div class="grid pt-10 pb-10 py-8 sm:pl-14 pl-3 pr-3 gap-y-6">
    <div class="grid w-full gap-y-3">
      <Heading level="h1">{t("nav.proyects")}</Heading>
      <p class="text-lg">{t("nav.typeProject")}</p>
      <ul
        class="flex overflow-auto whitespace-nowrap"
        style="scrollbar-width: thin; scrollbar-color: #888 transparent;"
      >
        {
          filterButtons.map((button: FilterButton) => (
            <li class="pentagon_item">
              <Button
                class:list={[
                  "border-figure! border-0! hover:border-b-4! hover:border-l-4! py-0! text-2xl! sm:p-2! p-2! px-4! sm:w-[24.3rem]! w-full! justify-start!",
                  button.name == t("nav.noFilter")
                    ? "bg-figure! text-white!"
                    : "bg-transparent!",
                ]}
                tag={button.tag}
              >
                {button.name}
              </Button>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="lg:columns-3 block justify-items-center">
      {
        Array.isArray(projects) && projects.map((project) => (
          <Card
            class="w-full mb-3 border-figure!"
            img={project.data.images[0].url.src}
            title={project.data.name}
            id={project.id}
            url={"#" + project.id.split("/").pop()}
          >
            <span slot="meta">
              <Badge>.</Badge>
            </span>
            <p>{t("nav.seeMore")}</p>
          </Card>
        ))
      }
    </div>
  </div>
</project-section>
<script>
  class ProjectSection extends HTMLElement {
    connectedCallback() {
      const filterBtns = this.querySelectorAll("button");
      const projectCards = this.querySelectorAll("article");

      Array.from(filterBtns).forEach((btn) => {
        btn.addEventListener("click", () => {
          Array.from(filterBtns).forEach((b) => {
            b.classList.remove("bg-figure!", "text-white!");
            b.classList.add("bg-transparent!");
          });

          btn.classList.remove("bg-transparent!");
          btn.classList.add("bg-figure!", "text-white!");

          const tag = btn.getAttribute("tag") ?? "";

          Array.from(projectCards).forEach((card) => {
            if (card.id.startsWith(tag)) {
              card.classList.remove("hidden!");
            } else {
              card.classList.add("hidden!");
            }
          });
        });
      });
    }
  }

  customElements.define("project-section", ProjectSection);
</script>

---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { Icon } from "astro-icon/components";
import { Link } from "accessible-astro-components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<footer>
  <div
    class="w-full bg-figure inset-be-0 flex items-center justify-between fixed px-1.5 text-white"
  >
    <div>
      <p class="hidden md:block">{t("webpage.title")}</p><p
        class="block md:hidden"
      >
        {t("webpage.title.short")}
      </p>
    </div>
    <div class="flex justify-end">
      <Link
        href="https://linkedin.com/in/puxka-acodom"
        class="inline-flex items-center"
        ><Icon name="linkedin" size="2rem" /><p class="hidden md:block">
          linkedin.com/in/puxka-acodom
        </p></Link
      >
    </div>
  </div>
</footer>

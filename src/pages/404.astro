---
import MainLayout from "../layouts/MainLayout.astro";
import dialogueImg from "../assets/images/dialogue.png";
import { Image } from "astro:assets";
import { Heading, Link } from "accessible-astro-components";
---

<MainLayout>
  <div
    class="w-screen h-screen flex flex-col items-center justify-center sticky top-0"
  >
    <div
      class="lg:w-4xl h-115 m-3 bg-cover p-3 bg-figure justify-center flex flex-col gap-4 text-white"
    >
      <div class="justify-end grid">
        <Image
          src={dialogueImg}
          width="200"
          height="200"
          alt=""
          class="-translate-x-px order-1 scale-x-[-1]"
        />
      </div>
      <Heading level="h1" size="h3" class="font-bold">Sorry!</Heading>
      <p>The page you are looking for does not exist</p>
      <p>
        Please return to the previous page or <Link
          href="/"
          class="inline-flex items-center"
          style="text-decoration: underline;"
          ariaLabel="Link to home page">click here</Link
        > to go home
      </p>
    </div>
    <div class="px-3">
      <p class="w-fit">Page made by me.</p>
      <p>Design: Figma + PowerPoint. Build: Astro + React + TailwindCSS. Deploy: Vercel</p>
    </div>
  </div>
</MainLayout>

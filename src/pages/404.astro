---
import MainLayout from "../layouts/MainLayout.astro";
import { getImage } from "astro:assets";
import welcomeImg from "../assets/images/welcome_dialogue.svg";
import { Heading, Link } from "accessible-astro-components";

const bgImage = await getImage({ src: welcomeImg });
---

<MainLayout>
  <div
    class="w-screen h-screen flex flex-col items-center justify-center sticky top-0"
  >
    <div
      style={`background-image: url(${bgImage.src});`}
      class="lg:w-4xl h-115 m-3 md:bg-cover md:pl-86 px-3 md:bg-transparent bg-figure bg-size-[390px] bg-no-repeat md:bg-left bg-position-[right_-230px_top_-20px] justify-center flex flex-col gap-4 text-white"
    >
      <Heading level="h1" size="h3" class="font-bold">Sorry!</Heading>
      <p>The page you are looking for does not exist</p>
      <p>
        Please return to the previous page or <Link href="/" class="inline-flex items-center" style="text-decoration: underline;" ariaLabel="Link to home page">click here</Link> to go home
      </p>
    </div>
    <div class="px-3">
      Page made by me. Design: Figma + PowerPoint. Build: Astro + TailwindCSS.
      Deploy: Vercel
    </div>
  </div>
</MainLayout>

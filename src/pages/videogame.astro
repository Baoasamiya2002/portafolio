---
import MainLayout from "../layouts/MainLayout.astro";
import ProjectSection from "../layouts/ProjectSection.astro";
import DivDialogue from "../components/DivDialogue.astro";
import { Heading, Link } from "accessible-astro-components";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const t = useTranslations(lang);

const path = translatePath("/videogame/").replace(/^\//, "");
const projects = (await getCollection("projects")).filter((project) =>
  project.id.startsWith(path),
);
---

<MainLayout>
  <ProjectSection title={t("nav.videogame")}>
    {
      projects.map((project) => (
        <div class="flex flex-col gap-6">
          <Heading level="h3" size="h6" class="pt-2">
            {project.data.name}
          </Heading>
          <Link href={project.data.link} isExternal>
            {t("project.videogame.linkLabel")}
          </Link>
          <DivDialogue softSkill={false}>{project.data.brief}</DivDialogue>
          <DivDialogue softSkill={true}>
            {project.data["soft-skill"]}
          </DivDialogue>
          {project.data.dialogues.map((dialogue, index) => (
            <>
              <DivDialogue softSkill={false}>{dialogue}</DivDialogue>
              <div class="md:inline-flex items-end text-white bg-[linear-gradient(to_bottom,transparent_22%,#7030a0_22%)]">
                {project.data.images
                  .filter((image) => image.indexDialogue === `${index}`)
                  .map((image) => (
                    <figure>
                      <Image src={image.url} alt="" class="h-auto w-full" />
                      <figcaption class="p-1 pl-2">{image.caption}</figcaption>
                    </figure>
                  ))}
              </div>
            </>
          ))}
        </div>
      ))
    }
    <div class="h-10"></div>
  </ProjectSection>
</MainLayout>
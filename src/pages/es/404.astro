---
import MainLayout from "../../layouts/MainLayout.astro";
import dialogueImg from "../../assets/images/dialogue.png";
import { Image } from "astro:assets";
import { Heading, Link } from "accessible-astro-components";
---

<MainLayout>
  <div
    class="w-screen h-screen flex flex-col items-center justify-center sticky top-0"
  >
    <div
      class="lg:w-4xl h-115 m-3 bg-cover p-3 bg-figure justify-center flex flex-col gap-4 text-white"
    >
      <div class="justify-end grid">
        <Image
          src={dialogueImg}
          width="200"
          height="200"
          alt=""
          class="-translate-x-px order-1 scale-x-[-1]"
        />
      </div>
      <Heading level="h1" size="h3" class="font-bold">¡Lo siento!</Heading>
      <p>La página que estás buscando no existe</p>
      <p>
        Por favor, regresa a la página anterior o <Link
          href="/"
          class="inline-flex items-center"
          style="text-decoration: underline;"
          ariaLabel="Link a página de inicio">haz clic aquí</Link
        > para ir a la página de inicio
      </p>
    </div>
    <div class="px-3">
      <p class="w-fit">Página hecha por mí.</p>
      <p>Diseño: Figma + PowerPoint. Desarrollo: Astro + React + TailwindCSS. Despliegue: Vercel</p>
    </div>
  </div>
</MainLayout>

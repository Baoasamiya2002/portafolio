---
import MainLayout from "../../layouts/MainLayout.astro";
import ProjectSection from "../../layouts/ProjectSection.astro";
import { getImage } from "astro:assets";
import welcomeImg from "../../assets/images/welcome_dialogue.svg";
import { Heading } from "accessible-astro-components";
import { Icon } from "astro-icon/components";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

const bgImage = await getImage({ src: welcomeImg });
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<MainLayout>
  <div class="w-screen h-screen flex items-center justify-center sticky top-0 -z-1">
    <div
      style={`background-image: url(${bgImage.src});`}
      class="w-4xl h-115 m-3 md:bg-cover md:pl-86 pl-3 md:bg-transparent bg-figure bg-size-[390px] bg-no-repeat md:bg-left bg-position-[right_-230px_top_-20px] pr-3 justify-center flex flex-col gap-4 text-white"
    >
      <Heading level="h1" size="h3" class="font-bold">¡Hola!</Heading>
      <p>¡Bienvenido a mi portafolio!</p>
      <p style="display: ruby;">
        Para ver mis proyectos, baja en la página o haz clic en el menú <Icon
          name="menu"
          size="1.5rem"
        /> de la esquina superior de la página
      </p>
      <p style="display: ruby;">
        También puedes alternar entre un tema obscuro <Icon
          name="moon-stars"
          size="1.5rem"
        /> o claro <Icon name="sun" size="1.5rem" /> y cambiar el idioma de la página
        (English/Español)
      </p>
      <p style="display: ruby;">
        Mi LinkedIn <Icon name="linkedin" size="1.5rem" /> está en la parte inferior de la página,
        no dudes en contactarme
      </p>
      <p>¡Gracias por tu visita!</p>
    </div>
  </div>
  <main>
    <section
      id="web-proto"
      class="min-h-[calc(100vh+5rem)] bg-bg"
    >
      <div class="bg-figure w-full h-1 sticky top-0"></div>
      <ProjectSection title={t("nav.prototype")} path={"es/web-proto/"}/>
    </section>
    <section
      id="eva-and-redes-works"
      class="min-h-[calc(100vh+5rem)] bg-bg"
    >
      <div class="bg-figure w-full h-1 sticky top-0"></div>
      <ProjectSection
        title={t("nav.evaluation")}
        path={"es/eva-and-redes-works/"}
      />
    </section>
    <section
      id="videogame"
      class="min-h-[calc(100vh+5rem)] bg-bg"
    >
      <div class="bg-figure w-full h-1 sticky top-0"></div>
      <ProjectSection title={t("nav.videogame")} path={"es/videogame/"} />
    </section>
  </main>
</MainLayout>
